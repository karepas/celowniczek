<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Celowniczek"
           Manufacturer="karepas"
           Version="1.0.2"
           UpgradeCode="a8b1c2d3-e4f5-6789-abcd-ef0123456789">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Celowniczek is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Ustawienie ikony instalatora w Dodaj/Usuń programy -->
    <Icon Id="AppIcon.ico" SourceFile="app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Struktura katalogów docelowych -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Celowniczek" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Składniki instalatora -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      
      <!-- Główny plik wykonywalny programu oraz ikona -->
      <Component Id="MainExecutable" Guid="b1c2d3e4-f5a6-7890-bcde-f01234567890">
        <File Id="CelowniczekEXE" Source="bin\Release\net8.0-windows\win-x64\publish\Celowniczek.exe" KeyPath="yes" />
        <File Id="AppIconFile" Source="app.ico" />

        <!-- Skrót na Pulpicie -->
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Celowniczek"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  Advertise="yes" />

        <!-- Skrót w Menu Start -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="Celowniczek"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico"
                  Advertise="yes" />
      </Component>

    </ComponentGroup>

    <!-- Sekcja instalacji składników -->
    <Feature Id="MainFeature" Title="Celowniczek" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

  </Package>
</Wix>